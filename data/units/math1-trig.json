        "ko": "{fn} {deg}°의 값은?",
        "en": "What is the exact value of {fn} {deg}°?"
      },
      "explain": {
        "ja": "{fn} {deg}° = {answer} (鈍角では cos と tan が負になる)",
        "ko": "{fn} {deg}° = {answer} (둔각에서는 cos과 tan이 음수)",
        "en": "{fn} {deg}° = {answer} (cos and tan are negative for obtuse angles)"
      },
      "items": [
        { "fn": "sin", "deg": 120, "answer": "√3/2", "wrong": [ "−√3/2", "1/2", "−1/2" ] },
        { "fn": "cos", "deg": 120, "answer": "−1/2", "wrong": [ "1/2", "−√3/2", "√3/2" ] },
        { "fn": "tan", "deg": 120, "answer": "−√3", "wrong": [ "√3", "−√3/3", "√3/3" ] },
        { "fn": "sin", "deg": 135, "answer": "√2/2", "wrong": [ "−√2/2", "1/2", "−1/2" ] },
        { "fn": "cos", "deg": 135, "answer": "−√2/2", "wrong": [ "√2/2", "−1/2", "−√3/2" ] },
        { "fn": "tan", "deg": 135, "answer": "−1", "wrong": [ "1", "−√2/2", "√2/2" ] },
        { "fn": "sin", "deg": 150, "answer": "1/2", "wrong": [ "−1/2", "√3/2", "−√3/2" ] },
        { "fn": "cos", "deg": 150, "answer": "−√3/2", "wrong": [ "√3/2", "−1/2", "1/2" ] },
        { "fn": "tan", "deg": 150, "answer": "−√3/3", "wrong": [ "√3/3", "−√3", "√3" ] },
        { "fn": "sin", "deg": 90, "answer": "1", "wrong": [ "0", "−1", "1/2" ] },
        { "fn": "cos", "deg": 90, "answer": "0", "wrong": [ "1", "−1", "1/2" ] },
        { "fn": "cos", "deg": 180, "answer": "−1", "wrong": [ "1", "0", "−1/2" ] },
        { "fn": "sin", "deg": 180, "answer": "0", "wrong": [ "1", "−1", "1/2" ] }
      ]
    },
    {
      "id": "ratio-from-sides",
      "level": 1,
      "type": "ratio",
      "gen": "ratio",
      "figure": {
        "kind": "triangle",
        "angle": "θ",
        "opp": "{a}",
        "adj": "{b}",
        "hyp": "{c}"
      },
      "text": {
        "ja": "図の直角三角形で、{fn} θ は?",
        "ko": "그림의 직각삼각형에서 {fn} θ는?",
        "en": "In the right triangle shown, what is {fn} θ?"
      },
      "explain": {
        "ja": "sin = 対辺/斜辺、cos = 隣辺/斜辺、tan = 対辺/隣辺 なので {fn} θ = {answer}",
        "ko": "sin=맞은편/빗변, cos=이웃/빗변, tan=맞은편/이웃이므로 {fn} θ = {answer}",
        "en": "sin = opposite/hypotenuse, cos = adjacent/hypotenuse, tan = opposite/adjacent, so {fn} θ = {answer}"
      }
    },
    {
      "id": "relation",
      "level": 2,
      "type": "relation",
      "gen": "relation",
      "text": {
        "ja": "θ が鋭角で {given} θ = {gv} のとき、{ask} θ は?",
        "ko": "θ가 예각이고 {given} θ = {gv}일 때, {ask} θ는?",
        "en": "θ is acute and {given} θ = {gv}. What is {ask} θ?"
      },
      "explain": {
        "ja": "sin²θ + cos²θ = 1、tan θ = sin θ / cos θ より {ask} θ = {answer}",
        "ko": "sin²θ + cos²θ = 1, tan θ = sin θ / cos θ이므로 {ask} θ = {answer}",
        "en": "From sin²θ + cos²θ = 1 and tan θ = sin θ / cos θ, {ask} θ = {answer}"
      }
    },
    {
      "id": "relation-obtuse",
      "level": 3,
      "type": "relation",
      "gen": "relation",
      "params": {
        "obtuse": true
      },
      "text": {
        "ja": "θ が鈍角で {given} θ = {gv} のとき、{ask} θ は?",
        "ko": "θ가 둔각이고 {given} θ = {gv}일 때, {ask} θ는?",
        "en": "θ is obtuse and {given} θ = {gv}. What is {ask} θ?"
      },
      "explain": {
        "ja": "鈍角では cos θ と tan θ は負。sin²θ + cos²θ = 1 より {ask} θ = {answer}",
        "ko": "둔각에서는 cos θ와 tan θ가 음수입니다. sin²θ + cos²θ = 1이므로 {ask} θ = {answer}",
        "en": "For an obtuse angle cos θ and tan θ are negative. From sin²θ + cos²θ = 1, {ask} θ = {answer}"
      }
    },
    {
      "id": "length-sin30",
      "level": 2,
      "type": "length",
      "gen": "length",
      "figure": {
        "kind": "triangle",
        "angle": "30°",
        "opp": "?",
        "adj": "",
        "hyp": "{c} m"
      },
      "text": {
        "ja": "図の直角三角形で、? の辺の長さは? (sin 30° = 1/2)",
        "ko": "그림의 직각삼각형에서 ?로 표시한 변의 길이는? (sin 30° = 1/2)",
        "en": "In the right triangle shown, how long is the side marked ? (sin 30° = 1/2)"
      },
      "explain": {
        "ja": "対辺 = 斜辺 × sin 30° = {c} × 1/2 = {answer}",
        "ko": "맞은편 변 = 빗변 × sin 30° = {c} × 1/2 = {answer}",
        "en": "Opposite = hypotenuse × sin 30° = {c} × 1/2 = {answer}"
      }
    },
    {
      "id": "length-cos60",
      "level": 2,
      "type": "length",
      "gen": "length",
      "figure": {
        "kind": "triangle",
        "angle": "60°",
        "opp": "",
        "adj": "?",
        "hyp": "{c} m"
      },
      "text": {
        "ja": "図の直角三角形で、? の辺の長さは? (cos 60° = 1/2)",
        "ko": "그림의 직각삼각형에서 ?로 표시한 변의 길이는? (cos 60° = 1/2)",
        "en": "In the right triangle shown, how long is the side marked ? (cos 60° = 1/2)"
      },
      "explain": {
        "ja": "隣辺 = 斜辺 × cos 60° = {c} × 1/2 = {answer}",
        "ko": "이웃 변 = 빗변 × cos 60° = {c} × 1/2 = {answer}",
        "en": "Adjacent = hypotenuse × cos 60° = {c} × 1/2 = {answer}"
      }
    },
    {
      "id": "tower-height",
      "level": 2,
      "type": "height",
      "gen": "height",
      "figure": {
        "kind": "tower",
        "angle": "{deg}°",
        "dist": "{d} m",
        "height": "?"
      },
      "text": {
        "ja": "図のように、{d}m 離れた地点から塔の先端を見上げた角が {deg}° である。塔の高さは?",
        "ko": "그림처럼 {d}m 떨어진 지점에서 탑 꼭대기를 올려본 각이 {deg}°이다. 탑의 높이는?",
        "en": "As shown, from a point {d} m away the angle of elevation to the top of the tower is {deg}°. How tall is the tower?"
      },
      "explain": {
        "ja": "高さ = {d} × tan {deg}° = {answer}",
        "ko": "높이 = {d} × tan {deg}° = {answer}",
        "en": "Height = {d} × tan {deg}° = {answer}"
      }
    },
    {
      "id": "two-points",
      "level": 3,
      "type": "twopoint",
      "gen": "twopoint",
      "figure": {
        "kind": "twopoint",
        "far": "{a}°",
        "near": "{b}°",
        "gap": "{g} m",
        "height": "?"
      },
      "text": {
        "ja": "図のように、{g}m 離れた2地点から塔の先端を見上げた角が {a}° と {b}° である。塔の高さは?",
        "ko": "그림처럼 {g}m 떨어진 두 지점에서 탑 꼭대기를 올려본 각이 {a}°와 {b}°이다. 탑의 높이는?",
        "en": "As shown, from two points {g} m apart the angles of elevation to the top of the tower are {a}° and {b}°. How tall is the tower?"
      },
      "explain": {
        "ja": "高さ = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}",
        "ko": "높이 = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}",
        "en": "Height = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}"
      }
    },
    {
      "id": "sine-rule",
      "level": 2,
      "type": "sinerule",
      "gen": "sinerule",
      "figure": {
        "kind": "anytri",
        "angleA": "{A}°",
        "angleB": "{B}°",
        "angleC": "",
        "sideA": "{a}",
        "sideB": "?",
        "sideC": ""
      },
      "text": {
        "ja": "△ABC で、a = {a}、A = {A}°、B = {B}° のとき、b は?",
        "ko": "△ABC에서 a = {a}, A = {A}°, B = {B}°일 때, b는?",
        "en": "In △ABC, a = {a}, A = {A}° and B = {B}°. What is b?"
      },
      "explain": {
        "ja": "正弦定理 a/sin A = b/sin B より b = {a} × sin {B}° ÷ sin {A}° = {answer}",
        "ko": "사인 법칙 a/sin A = b/sin B에서 b = {a} × sin {B}° ÷ sin {A}° = {answer}",
        "en": "By the law of sines a/sin A = b/sin B, so b = {a} × sin {B}° ÷ sin {A}° = {answer}"
      }
    },
    {
      "id": "sine-radius",
      "level": 2,
      "type": "sinerule",
      "gen": "sineR",
      "text": {
        "ja": "△ABC で、a = {a}、A = {A}° のとき、外接円の半径 R は?",
        "ko": "△ABC에서 a = {a}, A = {A}°일 때, 외접원의 반지름 R은?",
        "en": "In △ABC, a = {a} and A = {A}°. What is the circumradius R?"
      },
      "explain": {
        "ja": "正弦定理 a/sin A = 2R より R = {answer}",
        "ko": "사인 법칙 a/sin A = 2R에서 R = {answer}",
        "en": "By the law of sines a/sin A = 2R, so R = {answer}"
      }
    },
    {
      "id": "cosine-rule",
      "level": 2,
      "type": "cosrule",
      "gen": "cosrule",
      "figure": {
        "kind": "anytri",
        "angleA": "{A}°",
        "angleB": "",
        "angleC": "",
        "sideA": "?",
        "sideB": "{b}",
        "sideC": "{c}"
      },
      "text": {
        "ja": "△ABC で、b = {b}、c = {c}、A = {A}° のとき、a は?",
        "ko": "△ABC에서 b = {b}, c = {c}, A = {A}°일 때, a는?",
        "en": "In △ABC, b = {b}, c = {c} and A = {A}°. What is a?"
      },
      "explain": {
        "ja": "余弦定理 a² = b² + c² − 2bc cos A より a = {answer}",
        "ko": "코사인 법칙 a² = b² + c² − 2bc cos A에서 a = {answer}",
        "en": "By the law of cosines a² = b² + c² − 2bc cos A, so a = {answer}"
      }
    },
    {
      "id": "cosine-angle",
      "level": 3,
      "type": "cosrule",
      "gen": "cosangle",
      "figure": {
        "kind": "anytri",
        "angleA": "?",
        "angleB": "",
        "angleC": "",
        "sideA": "{a}",
        "sideB": "{b}",
        "sideC": "{c}"
      },
      "text": {
        "ja": "△ABC で、a = {a}、b = {b}、c = {c} のとき、A は?",
        "ko": "△ABC에서 a = {a}, b = {b}, c = {c}일 때, A는?",
        "en": "In △ABC, a = {a}, b = {b} and c = {c}. What is A?"
      },
      "explain": {
        "ja": "余弦定理 cos A = (b² + c² − a²) / 2bc を計算すると A = {answer}",
        "ko": "코사인 법칙 cos A = (b² + c² − a²) / 2bc를 계산하면 A = {answer}",
        "en": "Using the law of cosines cos A = (b² + c² − a²) / 2bc gives A = {answer}"
      }
    },
    {
      "id": "triangle-area",
      "level": 2,
      "type": "area",
      "gen": "area",
      "figure": {
        "kind": "anytri",
        "angleA": "{A}°",
        "angleB": "",
        "angleC": "",
        "sideA": "",
        "sideB": "{b}",
        "sideC": "{c}"
      },
      "text": {
        "ja": "△ABC で、b = {b}、c = {c}、A = {A}° のとき、面積 S は?",
        "ko": "△ABC에서 b = {b}, c = {c}, A = {A}°일 때, 넓이 S는?",
        "en": "In △ABC, b = {b}, c = {c} and A = {A}°. What is the area S?"
      },
      "explain": {
        "ja": "S = (1/2) bc sin A = (1/2) × {b} × {c} × sin {A}° = {answer}",
        "ko": "S = (1/2) bc sin A = (1/2) × {b} × {c} × sin {A}° = {answer}",
        "en": "S = (1/2) bc sin A = (1/2) × {b} × {c} × sin {A}° = {answer}"
      }
    }
  ]
