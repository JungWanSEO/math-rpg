    },
    {
      "id": "two-points",
      "level": 3,
      "type": "twopoint",
      "figure": {
        "kind": "twopoint",
        "far": "{a}°",
        "near": "{b}°",
        "gap": "{g} m",
        "height": "?"
      },
      "text": {
        "ja": "図のように、{g}m 離れた2地点から塔の先端を見上げた角が {a}° と {b}° である。塔の高さは?",
        "ko": "그림처럼 {g}m 떨어진 두 지점에서 탑 꼭대기를 올려본 각이 {a}°와 {b}°이다. 탑의 높이는?",
        "en": "As shown, from two points {g} m apart the angles of elevation to the top of the tower are {a}° and {b}°. How tall is the tower?"
      },
      "explain": {
        "ja": "高さ = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}",
        "ko": "높이 = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}",
        "en": "Height = {g} × tan {a}° × tan {b}° ÷ (tan {b}° − tan {a}°) = {answer}"
      },
      "items": [
        { "g": 6, "a": 30, "b": 45, "answer": "(3 + 3√3) m", "wrong": [ "2√3 m", "6 m", "(9 − 3√3) m" ] },
        { "g": 8, "a": 30, "b": 60, "answer": "4√3 m", "wrong": [ "8√3/3 m", "8√3 m", "2√3 m" ] },
        { "g": 10, "a": 45, "b": 60, "answer": "(15 + 5√3) m", "wrong": [ "10 m", "10√3 m", "(5√3 − 5) m" ] },
        { "g": 12, "a": 30, "b": 45, "answer": "(6 + 6√3) m", "wrong": [ "4√3 m", "12 m", "(18 − 6√3) m" ] }
      ]
