  "templates": [
    {
      "id": "exact-value",
      "level": 1,
      "type": "value",
      "text": {
        "ja": "{fn} {deg}° の値は?",
        "ko": "{fn} {deg}°의 값은?",
        "en": "What is the exact value of {fn} {deg}°?"
      },
      "explain": {
        "ja": "{fn} {deg}° = {answer}",
        "ko": "{fn} {deg}° = {answer}",
        "en": "{fn} {deg}° = {answer}"
      },
      "items": [
        { "fn": "sin", "deg": 30, "answer": "1/2", "wrong": [ "√2/2", "√3/2", "√3/3" ] },
        { "fn": "sin", "deg": 45, "answer": "√2/2", "wrong": [ "1/2", "√3/2", "√3/3" ] },
        { "fn": "sin", "deg": 60, "answer": "√3/2", "wrong": [ "1/2", "√2/2", "√3/3" ] },
        { "fn": "cos", "deg": 30, "answer": "√3/2", "wrong": [ "1/2", "√2/2", "√3/3" ] },
        { "fn": "cos", "deg": 45, "answer": "√2/2", "wrong": [ "1/2", "√3/2", "√3/3" ] },
        { "fn": "cos", "deg": 60, "answer": "1/2", "wrong": [ "√2/2", "√3/2", "√3/3" ] },
        { "fn": "tan", "deg": 30, "answer": "√3/3", "wrong": [ "1/2", "√2/2", "√3/2" ] },
        { "fn": "tan", "deg": 45, "answer": "1", "wrong": [ "1/2", "√2/2", "√3/2" ] },
        { "fn": "tan", "deg": 60, "answer": "√3", "wrong": [ "1/2", "√2/2", "√3/2" ] }
      ]
    },
    {
      "id": "ratio-from-sides",
      "level": 1,
      "type": "ratio",
      "figure": {
        "kind": "triangle",
        "angle": "θ",
        "opp": "{a}",
        "adj": "{b}",
        "hyp": "{c}"
      },
      "text": {
        "ja": "図の直角三角形で、{fn} θ は?",
        "ko": "그림의 직각삼각형에서 {fn} θ는?",
        "en": "In the right triangle shown, what is {fn} θ?"
      },
      "explain": {
        "ja": "sin = 対辺/斜辺、cos = 隣辺/斜辺、tan = 対辺/隣辺 なので {fn} θ = {answer}",
        "ko": "sin=맞은편/빗변, cos=이웃/빗변, tan=맞은편/이웃이므로 {fn} θ = {answer}",
        "en": "sin = opposite/hypotenuse, cos = adjacent/hypotenuse, tan = opposite/adjacent, so {fn} θ = {answer}"
      },
      "items": [
        { "a": 3, "b": 4, "c": 5, "fn": "sin", "answer": "3/5", "wrong": [ "4/5", "3/4", "5/4" ] },
        { "a": 3, "b": 4, "c": 5, "fn": "cos", "answer": "4/5", "wrong": [ "3/5", "3/4", "4/3" ] },
        { "a": 3, "b": 4, "c": 5, "fn": "tan", "answer": "3/4", "wrong": [ "3/5", "4/5", "4/3" ] },
        { "a": 5, "b": 12, "c": 13, "fn": "sin", "answer": "5/13", "wrong": [ "12/13", "5/12", "13/12" ] },
        { "a": 5, "b": 12, "c": 13, "fn": "cos", "answer": "12/13", "wrong": [ "5/13", "5/12", "12/5" ] },
        { "a": 8, "b": 15, "c": 17, "fn": "sin", "answer": "8/17", "wrong": [ "15/17", "8/15", "17/15" ] },
        { "a": 8, "b": 15, "c": 17, "fn": "cos", "answer": "15/17", "wrong": [ "8/17", "8/15", "15/8" ] },
        { "a": 7, "b": 24, "c": 25, "fn": "sin", "answer": "7/25", "wrong": [ "24/25", "7/24", "25/24" ] }
      ]
    },
    {
      "id": "length-sin30",
      "level": 2,
      "type": "length",
      "figure": {
        "kind": "triangle",
        "angle": "30°",
        "opp": "?",
        "adj": "",
        "hyp": "{c} m"
      },
      "text": {
        "ja": "図の直角三角形で、? の辺の長さは? (sin 30° = 1/2)",
        "ko": "그림의 직각삼각형에서 ?로 표시한 변의 길이는? (sin 30° = 1/2)",
        "en": "In the right triangle shown, how long is the side marked ? (sin 30° = 1/2)"
      },
      "explain": {
        "ja": "対辺 = 斜辺 × sin 30° = {c} × 1/2 = {answer}",
        "ko": "맞은편 변 = 빗변 × sin 30° = {c} × 1/2 = {answer}",
        "en": "Opposite = hypotenuse × sin 30° = {c} × 1/2 = {answer}"
      },
      "items": [
        { "c": 12, "answer": "6 m", "wrong": [ "12 m", "18 m", "10 m" ] },
        { "c": 20, "answer": "10 m", "wrong": [ "20 m", "30 m", "14 m" ] },
        { "c": 30, "answer": "15 m", "wrong": [ "30 m", "45 m", "19 m" ] }
      ]
    },
    {
      "id": "length-cos60",
      "level": 2,
      "type": "length",
      "figure": {
        "kind": "triangle",
        "angle": "60°",
        "opp": "",
        "adj": "?",
        "hyp": "{c} m"
      },
      "text": {
        "ja": "図の直角三角形で、? の辺の長さは? (cos 60° = 1/2)",
        "ko": "그림의 직각삼각형에서 ?로 표시한 변의 길이는? (cos 60° = 1/2)",
        "en": "In the right triangle shown, how long is the side marked ? (cos 60° = 1/2)"
      },
      "explain": {
        "ja": "隣辺 = 斜辺 × cos 60° = {c} × 1/2 = {answer}",
        "ko": "이웃 변 = 빗변 × cos 60° = {c} × 1/2 = {answer}",
        "en": "Adjacent = hypotenuse × cos 60° = {c} × 1/2 = {answer}"
