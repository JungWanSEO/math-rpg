        "ko": "{fn} {deg}° = {answer}",
        "en": "{fn} {deg}° = {answer}"
      },
      "items": [
        { "fn": "sin", "deg": 30, "answer": "1/2", "wrong": [ "√2/2", "√3/2", "√3/3" ] },
