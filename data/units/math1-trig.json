    {
      "id": "tower-height",
      "level": 2,
      "type": "height",
      "figure": {
        "kind": "tower",
        "angle": "{deg}°",
        "dist": "{d} m",
        "height": "?"
      },
      "text": {
        "ja": "図のように、{d}m 離れた地点から塔の先端を見上げた角が {deg}° である。塔の高さは?",
