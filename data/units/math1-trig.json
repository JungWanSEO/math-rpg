        "en": "As shown, from a point {d} m away the angle of elevation to the top of the tower is {deg}°. How tall is the tower?"
      },
      "explain": {
        "ja": "高さ = {d} × tan {deg}° = {answer}",
        "ko": "높이 = {d} × tan {deg}° = {answer}",
        "en": "Height = {d} × tan {deg}° = {answer}"
      },
      "items": [
        { "d": 8, "deg": 30, "answer": "8√3/3 m", "wrong": [ "8√3 m", "4 m", "4√3 m" ] },
        { "d": 12, "deg": 45, "answer": "12 m", "wrong": [ "6√2 m", "14 m", "13 m" ] },
        { "d": 16, "deg": 60, "answer": "16√3 m", "wrong": [ "16√3/3 m", "8√3 m", "8 m" ] },
        { "d": 15, "deg": 30, "answer": "5√3 m", "wrong": [ "15√3 m", "15/2 m", "5 m" ] },
        { "d": 18, "deg": 45, "answer": "18 m", "wrong": [ "9√2 m", "20 m", "9 m" ] },
        { "d": 25, "deg": 60, "answer": "25√3 m", "wrong": [ "25√3/3 m", "25√3/2 m", "25 m" ] }
